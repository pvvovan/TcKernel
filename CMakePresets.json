{
    "version": 10,

    "configurePresets":
    [
        {
            "name": "cfg",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/lbuild",
            "toolchainFile": "${sourceDir}/lbuild/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],

    "buildPresets":
    [
        {
            "name": "bld",
            "configurePreset": "cfg",
            "jobs": 0
        }
    ],

    "workflowPresets":
    [
        {
            "name": "Compile",
            "steps":
            [
                {
                    "type": "configure",
                    "name": "cfg"
                },
                {
                    "type": "build",
                    "name": "bld"
                }
            ]
        }
    ]
}
