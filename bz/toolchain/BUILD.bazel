load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

constraint_value(
    name = "tricore_cpu",
    constraint_setting = "@platforms//cpu:cpu",
)

platform(
    name = "tricore_platform",
    constraint_values = [
        ":tricore_cpu",
        "@platforms//os:none",
    ],
)

filegroup(name = "empty")

cc_toolchain_config(name = "tricore_toolchain_config")

cc_toolchain(
    name = "tricore_toolchain",
    toolchain_config = ":tricore_toolchain_config",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
)

toolchain(
    name = "cc_toolchain_for_tricore",
    toolchain = ":tricore_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    target_compatible_with = [
        ":tricore_cpu",
        "@platforms//os:none",
    ],
)
